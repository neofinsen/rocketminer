{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rocketminer",
  "version": "0.1.0",
  "identifier": "com.neofinsen.rocketminer",
  "build": {
    "beforeDevCommand": "npm run dev:desktop-web",
    "beforeBuildCommand": "npm run build:desktop-web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rocketminer",
        "label": "main",
        "width": 1600,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "neofinsen"
  }
}
